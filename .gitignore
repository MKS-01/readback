# --- Python ---
.venv/
__pycache__/
*.pyc
*.pyo
*.egg-info/
build/
# `dist/` matches any directory named dist anywhere in the tree, including
# readback/web/static/dist/ (Vite build output) and the package build dir.
dist/
.pytest_cache/

# --- Node / Vite ---
node_modules/
*.tsbuildinfo
readback/web/frontend/dist/
# tsc -b emits .js / .d.ts next to the .ts source for the vite config; ignore both.
readback/web/frontend/vite.config.js
readback/web/frontend/vite.config.d.ts

# --- IDE / agent state ---
.idea/
.vscode/
.claude/*
# …but keep checked-in Claude Code skills (shared project workflows).
!.claude/skills/

# --- Local state & secrets ---
.env
.env.local
config.local.yaml

# --- Runtime artifacts ---
# Crash-recovery JSONLs live under ~/.readback/sessions/, not in the repo,
# but ignore any accidental local copy.
.readback/

# --- Captured audio (sample files, debugging) ---
*.wav
*.mp3
# Exception: committed reference clips that config.yaml voices depend on
# (the clone-condition voice must travel with the repo to be reproducible).
!src/voice/voice_kay_default.wav
!src/voice/voice_kay_long.wav
# Exception: README demo media
!docs/media/sample-read.wav

# --- Fine-tuning (local training data + adapter weights, large) ---
src/finetune/data/
src/finetune/runs/
src/finetune/dataset.json
*.safetensors

# --- macOS ---
.DS_Store

# --- Vendored ---
vendor/csm/

# --- Landing page (media is copied in by the Pages workflow / locally for preview) ---
src/landing-page/media/
