# --- Python ---
.venv/
__pycache__/
*.pyc
*.pyo
*.egg-info/
build/
# `dist/` matches any directory named dist anywhere in the tree, including
# vox_tinker/web/static/dist/ (Vite build output) and the package build dir.
dist/
.pytest_cache/

# --- Node / Vite ---
node_modules/
*.tsbuildinfo
vox_tinker/web/frontend/dist/
# tsc -b emits .js / .d.ts next to the .ts source for the vite config; ignore both.
vox_tinker/web/frontend/vite.config.js
vox_tinker/web/frontend/vite.config.d.ts

# --- IDE / agent state ---
.idea/
.vscode/
.claude/*
# …but keep checked-in Claude Code skills (shared project workflows).
!.claude/skills/

# --- Local state & secrets ---
.env
.env.local
config.local.yaml

# --- Runtime artifacts ---
# Crash-recovery JSONLs live under ~/.vox-tinker/sessions/, not in the repo,
# but ignore any accidental local copy.
.vox-tinker/

# --- Captured audio (sample files, debugging) ---
*.wav
*.mp3

# --- macOS ---
.DS_Store

# --- Vendored ---
vendor/csm/
