# --- Python ---
.venv/
__pycache__/
*.pyc
*.pyo
*.egg-info/
build/
# `dist/` matches any directory named dist anywhere in the tree, including
# local_tts/web/static/dist/ (Vite build output) and the package build dir.
dist/
.pytest_cache/

# --- Node / Vite ---
node_modules/
*.tsbuildinfo
local_tts/web/frontend/dist/
# tsc -b emits .js / .d.ts next to the .ts source for the vite config; ignore both.
local_tts/web/frontend/vite.config.js
local_tts/web/frontend/vite.config.d.ts

# --- IDE / agent state ---
.idea/
.vscode/
.claude/*
# …but keep checked-in Claude Code skills (shared project workflows).
!.claude/skills/

# --- Local state & secrets ---
.env
.env.local
config.local.yaml

# --- Runtime artifacts ---
# Crash-recovery JSONLs live under ~/.local-tts/sessions/, not in the repo,
# but ignore any accidental local copy.
.local-tts/

# --- Captured audio (sample files, debugging) ---
*.wav
*.mp3
# Exception: committed reference clips that config.yaml voices depend on
# (the clone-condition voice must travel with the repo to be reproducible).
!voice/voice_kay_default.wav

# --- Fine-tuning (local training data + adapter weights, large) ---
finetune/data/
finetune/runs/
finetune/dataset.json
*.safetensors

# --- macOS ---
.DS_Store

# --- Vendored ---
vendor/csm/
