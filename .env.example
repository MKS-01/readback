# ===========================================
# readback — Pi deployment config
# ===========================================
# cp .env.example .env  and fill in your values.
# .env is gitignored — never commit it.
# ===========================================

# ----- Pi connection -----
PI_USER=your_username
PI_HOST=192.168.x.x

# ----- Paths on Pi -----
# Where readback source lands on Pi
PI_PATH=/home/your_username/readback
# Where WAVs are stored on Pi (rsynced from Mac)
PI_AUDIO_DIR=/home/your_username/readback-audio-db/audio
# Where the SQLite library DB lives on Pi (rsynced from Mac)
PI_DB_PATH=/home/your_username/readback-audio-db/library.db

# ----- Server -----
PI_PORT=8080
