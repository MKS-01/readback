{
  "name": "readback-video",
  "version": "0.1.0",
  "private": true,
  "description": "Remotion explainer video for the readback README (how it works).",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts Explainer ../../docs/media/how-it-works.mp4 --codec=h264",
    "gif": "remotion render src/index.ts Explainer ../../docs/media/how-it-works.gif --codec=gif --every-nth-frame=2 --scale=0.75"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.0",
    "@remotion/google-fonts": "^4.0.0",
    "@remotion/media-utils": "^4.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.1",
    "typescript": "^5.5.0"
  }
}
